{
  "name": "Galette EEDS development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-docker",
        "xdebug.php-debug"
      ]
    }
  },
  "forwardPorts": [8125],
  "portsAttributes": {
    "8125": {
      "label": "Galette development",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bin/install_deps",
  "remoteUser": "vscode"
}
